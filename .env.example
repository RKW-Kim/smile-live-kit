# ─────────────────────────────────────────────────────────────
# Smile Live Kit — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` for local dev, or set these in the
# Vercel dashboard (Project → Settings → Environment Variables).
#
# On Vercel, set them for BOTH "Production" and "Preview" environments
# unless noted otherwise.

# Database (Prisma)
# Local dev: SQLite file (regenerable — gitignored)
# Vercel: SQLite doesn't work on serverless (read-only FS). Set a
# placeholder for now — the DB isn't used yet. When you add real
# data, switch to PostgreSQL (Neon, Supabase, or Vercel Postgres).
DATABASE_URL="file:./prisma/dev.db"

# ─── Future env vars (not required yet, documented for later) ───

# Twelve Data API (live market data for the ticker + chart)
# Free tier: 8 requests/min, 500/day. Get a key at twelvedata.com
# TWELVEDATA_API_KEY=""

# Deriv API (synthetic indices data — for Phase 2)
# DERIV_API_TOKEN=""

# OBS WebSocket (for the control panel → OBS scene switching)
# Only needed when the WebSocket control layer is built
# OBS_WS_URL="ws://localhost:4444"
# OBS_WS_PASSWORD=""
